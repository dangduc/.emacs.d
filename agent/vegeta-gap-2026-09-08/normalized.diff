+(defun vegeta--publish-render ()
+  "Publish the completed snapshot, preserving each current window view."
+  (let ((inhibit-quit t)
+        (location (vegeta--row-location (point)))
+        (views (mapcar
+                (lambda (window)
+                  (list window
+                        (vegeta--row-location (window-start window))
+                        (vegeta--row-location (window-point window))))
+                (get-buffer-window-list (current-buffer) nil t))))
+    (let ((inhibit-read-only t))
+      (erase-buffer)
+      (insert-buffer-substring vegeta--render-buffer))
+    (dolist (view views)
+      (when (window-live-p (car view))
+        (vegeta--restore-location (cadr view))
+        (set-window-start (car view) (line-beginning-position) t)
+        (vegeta--restore-location (caddr view))
+        (set-window-point (car view) (point))))
+    (vegeta--restore-location location))
+  (kill-buffer vegeta--render-buffer)
+  (setq vegeta--render-buffer nil
+        vegeta--render-iterator nil))
