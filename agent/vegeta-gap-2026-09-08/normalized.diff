+(defun vegeta--append-item (queue item)
+  "Append ITEM to the (HEAD . TAIL) QUEUE in constant time."
+  (let ((cell (list item)))
+    (if (cdr queue) (setcdr (cdr queue) cell) (setcar queue cell))
+    (setcdr queue cell)))
