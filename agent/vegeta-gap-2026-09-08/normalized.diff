+                         (funcall vegeta--owned-file-p-function file))
+                (user-error "Transcript belongs to an open session: %s" file))
+              (when (file-exists-p file) (delete-file file delete-by-moving-to-trash))
+              (cl-incf deleted)
+              (remhash file vegeta--parse-cache)
+              (remhash file vegeta--marks))
+          (file-error (push (error-message-string err) failures))
+          (user-error (push (error-message-string err) failures))))
+      (vegeta-refresh)
+      (if failures
+          (message "Deleted %d. Retained %d mark(s): %s"
+                   deleted (length failures) (string-join (nreverse failures) "; "))
+        (message "Deleted %d transcript(s)" deleted))))))
+
+(defun vegeta-refresh ()
+  "Rescan transcripts once and schedule uncached metadata for parsing."
+  (interactive)
+  (unless (derived-mode-p 'vegeta-mode)
+    (user-error "Not in an agent-shell sidebar"))
+  ;; Publish discovery only after it succeeds, preserving pending work on error.
+  (let* ((snapshot
+          (let ((vegeta--file-info nil))
+            (list (funcall (or vegeta--collect-function
+                               #'vegeta--collect))
+                  vegeta--file-info))))
+    (when (timerp vegeta--parse-timer)
+      (cancel-timer vegeta--parse-timer))
+    (setq vegeta--parse-timer nil
+          vegeta--groups (car snapshot)
+          vegeta--file-info (cadr snapshot)))
+  (vegeta--queue-uncached
+   (apply #'append (mapcar #'cdr vegeta--groups)))
+  (vegeta--redraw)
+  (vegeta--start-parse-timer))
+
+(defun vegeta--sidebar-window (&optional frame)
