+(defun vegeta--cancel-render ()
+  "Discard any unpublished snapshot and pending render request."
+  (setq vegeta--render-iterator nil
+        vegeta--render-dirty nil)
+  (when (buffer-live-p vegeta--render-buffer)
+    (kill-buffer vegeta--render-buffer))
+  (setq vegeta--render-buffer nil))
