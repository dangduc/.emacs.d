+(defun vegeta--render-tick ()
+  "Advance at most 300 path or row operations, coalescing parse updates.
+Publication copies a completed buffer and restores row locations."
+  (unless vegeta--render-error
+    (condition-case err
+        (progn
+          (when (and vegeta--render-dirty
+                     (not vegeta--render-iterator))
+            (setq vegeta--render-dirty nil
+                  vegeta--render-buffer
+                  (generate-new-buffer " *vegeta render*")
+                  vegeta--render-iterator
+                  (funcall (or vegeta--render-snapshot-function
+                               #'vegeta--render-snapshot)
+                           vegeta--render-buffer vegeta--groups
+                           vegeta--project-names)))
+          (let ((n 0))
+            (while (and vegeta--render-iterator (< n 300)
+                        (not (input-pending-p)))
+              (condition-case nil
+                  (iter-next vegeta--render-iterator)
+                (iter-end-of-sequence (vegeta--publish-render)))
+              (cl-incf n))))
+      (error
+       (vegeta--cancel-render)
+       (setq vegeta--render-error (error-message-string err))
+       (message "Sidebar redraw failed: %s" vegeta--render-error))
+      (quit
+       (vegeta--cancel-render)
+       (setq vegeta--render-dirty t)
+       (signal (car err) (cdr err)))))
+  (when vegeta--render-error
+    (setq vegeta--render-dirty nil)))
