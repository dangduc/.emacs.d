+(defun vegeta--update-header-line ()
+  "Update controls and work status without traversing the parse queue."
+  (setq header-line-format
+        (format " RET resume  o read  TAB fold  / filter  N new  g refresh%s%s%s"
+                (if (string-empty-p vegeta--filter) ""
+                  (concat " | " (replace-regexp-in-string "%" "%%" vegeta--filter)))
+                (if vegeta--parse-queue
+                    (format " | %d pending" vegeta--pending-count) "")
+                (cond (vegeta--render-error " | redraw failed; g retries")
+                      (vegeta--render-iterator " | updating view")
+                      (t "")))))
