(ert-deftest merge-progressive-tree-does-not-rediscover-and-bounds-rows ()
  (merge--fixture
    (let ((list-function (symbol-function 'agent-sidebar--agent-shell-list))
          (row-function (symbol-function 'agent-sidebar--render-entry-row))
          (agent-sidebar-enabled-providers '(agent-shell))
          (reads 0) (rows 0) (scans 0) (publications 0))
      (dotimes (i 420) (merge--markdown root (format "%04d" i) (format "s%d" i)))
      (cl-letf (((symbol-function 'agent-sidebar--agent-shell-list)
                 (lambda () (cl-incf scans) (funcall list-function)))
                ((symbol-function 'agent-sidebar--render-entry-row)
                 (lambda (&rest args) (cl-incf rows) (apply row-function args))))
        (agent-sidebar-refresh)
        (should (= scans 1))
        (while agent-sidebar--parse-timer
          (setq rows 0)
          (timer-event-handler agent-sidebar--parse-timer)
          (should (<= rows 300))
          (when (and agent-sidebar--parse-queue (string-search "Prompt " (buffer-string)))
            (cl-incf publications)))
        (setq reads (hash-table-count agent-sidebar--parse-cache))
        (should (= reads 420)) (should (> publications 0)) (should (= scans 1))
        (should (= (length (merge--rows)) 420))
        (should-not agent-shell-sidebar--render-error)
        (message "Provider tree: %d reads, %d scan, progressive publication observed" reads scans)))))

