(ert-deftest merge-vterm-launch-keeps-dedicated-sidebar-and-quotes-argv ()
  (merge--fixture
    (save-window-excursion
      (let ((ordinary (selected-window))
            (sidebar (display-buffer-in-side-window buffer '((side . left))))
            (args '("--resume" "space ' and $(text)")) target)
        (unwind-protect
            (progn
              (set-window-dedicated-p sidebar t)
              (select-window sidebar)
              (cl-letf (((symbol-function 'ghostel-exec) nil)
                        ((symbol-function 'vterm)
                         (lambda (name)
                           (should (eq ordinary (selected-window)))
                           (should (equal vterm-shell
                                          (mapconcat #'shell-quote-argument (cons "/bin/cat" args) " ")))
                           (should (equal default-directory root))
                           (setq target (generate-new-buffer name))
                           (pop-to-buffer-same-window target)
                           target)))
                (should (eq (agent-sidebar--launch-terminal " *merge vterm*" "/bin/cat" args root) target)))
              (should (eq (window-buffer sidebar) buffer))
              (should (window-dedicated-p sidebar))
              (should (eq (window-buffer ordinary) target)))
          (when target (kill-buffer target)))))))

