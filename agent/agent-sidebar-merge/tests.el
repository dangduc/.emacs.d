;;; tests.el --- Provider merge checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'agent-sidebar)

(defun merge--markdown (root name &optional session agent)
  (let ((file (expand-file-name (format ".agent-shell/transcripts/%s.md" name) root)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file
      (insert (format "**Agent:** %s\n**Working Directory:** %s\n**Started:** 2026-09-08 12:00:00\n**Session ID:** %s\n**Model:** shell-model\n---\n## User\n\nPrompt %s\n"
                      (or agent "Claude") root (or session "") name))) file))
(defun merge--json-file (root store name &optional records)
  (let ((file (expand-file-name (concat (agent-sidebar--claude-encode-path root) "/" name ".jsonl") store)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file
      (dolist (record (or records
                          `(((type . "user") (sessionId . ,name) (cwd . ,root)
                             (timestamp . "2026-09-08T19:00:00Z")
                             (isMeta . :json-false) (message . ((content . "CLI prompt") (role . "user"))))
                            ((type . "assistant") (message . ((model . "cli-model") (content . "answer")))))))
        (insert (json-encode record) "\n"))) file))
(defmacro merge--fixture (&rest body)
  (declare (indent 0))
  `(let* ((temporary (file-name-as-directory (make-temp-file "agent-sidebar-merge-" t)))
          (root (expand-file-name "repo-with space/" temporary))
          (store (expand-file-name "claude/" temporary))
          (agent-sidebar-extra-project-roots (list root))
          (agent-sidebar-claude-cli-projects-dir store)
          (agent-sidebar-enabled-providers '(agent-shell claude-cli))
          (agent-sidebar-grouping '(package repo model))
          (agent-sidebar-refresh-timer nil)
          (agent-sidebar-name " *merged sidebar test*")
          (agent-shell-sidebar--timer-buffers nil)
          (post-command-hook nil)
          (projectile-known-projects nil)
          (default-directory root)
          (buffer (generate-new-buffer " *merge fixture*")))
     (make-directory root t)
     (unwind-protect
         (cl-letf (((symbol-function 'project-known-project-roots) (lambda () nil))
                   ((symbol-function 'agent-shell-buffers) (lambda () nil))
                   ((symbol-function 'input-pending-p) (lambda () nil)))
                  (with-current-buffer buffer (agent-sidebar-mode) ,@body))
       (when (buffer-live-p buffer) (kill-buffer buffer))
       (when-let* ((sidebar (get-buffer agent-sidebar-name))) (kill-buffer sidebar))
       (delete-directory temporary t))))
(defun merge--drain ()
  (let ((ticks 0))
    (while (and (timerp agent-sidebar--parse-timer) (< ticks 1000))
      (timer-event-handler agent-sidebar--parse-timer)
      (cl-incf ticks))
    (should (< ticks 1000))
    (should-not agent-sidebar--parse-queue)
    (should-not agent-shell-sidebar--render-iterator)
    (should-not agent-shell-sidebar--render-dirty)
    (should-not agent-shell-sidebar--render-error)
    ticks))
(defun merge--goto (file)
  (goto-char (point-min))
  (while (and (not (eobp)) (not (equal file (get-text-property (point) 'agent-shell-sidebar-file))))
    (forward-line 1))
  (should-not (eobp)))
(defun merge--rows ()
  (let (files)
    (save-excursion
      (goto-char (point-min))
      (while (not (eobp))
        (when-let* ((file (get-text-property (point) 'agent-shell-sidebar-file))) (push file files))
        (forward-line 1)))
    (nreverse files)))

(ert-deftest merge-two-providers-metadata-model-and-nesting ()
  (merge--fixture
    (let ((md (merge--markdown root "one" "md-session"))
          (json (merge--json-file root store "cli-session")))
      (agent-sidebar-refresh)
      (should (= (length agent-sidebar--parse-queue) 2))
      (should (= (length (merge--rows)) 2))
      (merge--drain)
      (should (string-search "agent-shell (1)" (buffer-string)))
      (should (string-search "Claude CLI (1)" (buffer-string)))
      (should (string-search "shell-model (1)" (buffer-string)))
      (should (string-search "cli-model (1)" (buffer-string)))
      (should (string-search "CLI prompt" (buffer-string)))
      (should (equal (sort (list md json) #'string<) (sort (merge--rows) #'string<))))))

(ert-deftest merge-flat-date-filter-and-fold-preserve-marks ()
  (merge--fixture
    (let ((md (merge--markdown root "one" "session")))
      (merge--json-file root store "cli")
      (agent-sidebar-refresh) (merge--drain)
      (merge--goto md) (end-of-line) (agent-sidebar-mark-delete)
      (agent-sidebar-set-grouping nil)
      (should (= 2 (length (merge--rows))))
      (should-not (text-property-search-forward 'agent-sidebar-group nil (lambda (_ value) value)))
      (agent-sidebar-set-filter "shell-model")
      (should (equal (merge--rows) (list md)))
      (should (eq (gethash md agent-sidebar--marks) 'delete))
      (agent-sidebar-set-grouping '(date repo))
      (goto-char (point-min)) (end-of-line) (agent-sidebar-toggle-group)
      (should-not (merge--rows))
      (agent-sidebar-toggle-group)
      (should (equal (merge--rows) (list md)))
      (should-error (agent-sidebar-set-grouping '(repo repo)) :type 'user-error))))

(ert-deftest merge-jsonl-skips-meta-and-tools-and-reads-later-model ()
  (merge--fixture
    (let* ((records `(((type . "user") (isMeta . t) (message . ((content . "meta"))))
                      ((type . "user") (message . ((content . "<command-name>ignore"))))
                      ((type . "user") (isMeta . :json-false) (cwd . ,root)
                       (timestamp . "2026-09-08T19:00:00Z")
                       (message . ((content . [((type . "tool_result") (content . "ignore"))
                                               ((type . "text") (text . "Actual prompt\nnext"))]))))
                      ((type . "assistant") (message . ((model . "later-model"))))))
           (file (merge--json-file root store "short" records)))
      (with-temp-buffer (insert "\nnot json\n") (write-region (point-min) (point-max) file t 'silent))
      (let ((meta (agent-sidebar--claude-parse (list :id file))))
        (should-not (plist-get meta :error))
        (should (equal (plist-get meta :preview) "Actual prompt"))
        (should (equal (plist-get meta :model) "later-model"))
        (should (equal (plist-get meta :cwd) root))))))

(ert-deftest merge-jsonl-read-is-bounded-and-preserves-complete-records ()
  (merge--fixture
    (let* ((file (merge--json-file root store "bound"))
           (prefix (json-encode '((type . "user") (message . ((content . "first")))))))
      (with-temp-file file
        (insert prefix "\n" (json-encode `((padding . ,(make-string 70000 ?x)))) "\n"
                "{\"cwd\":\"/wrong\"}\n"))
      (let ((meta (agent-sidebar--claude-parse (list :id file))))
        (should (equal (plist-get meta :preview) "first"))
        (should-not (plist-get meta :cwd)))
      (with-temp-file file (insert prefix))
      (should (equal (plist-get (agent-sidebar--claude-parse (list :id file)) :preview) "first")))))

