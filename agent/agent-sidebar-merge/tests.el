(ert-deftest merge-cache-rechecks-size-and-recovers-read-permissions ()
  (merge--fixture
    (let ((file (merge--json-file root store "mutable")))
      (agent-sidebar-refresh) (merge--drain)
      (let ((stamp (file-attribute-modification-time (file-attributes file))))
        (with-temp-file file (insert (json-encode `((type . "user") (cwd . ,root)
                                                    (message . ((content . "changed and longer prompt")))))))
        (set-file-times file stamp)
        (let ((meta (agent-sidebar--ensure-parsed (gethash file agent-sidebar--entries))))
          (should (equal (plist-get meta :preview) "changed and longer prompt"))))
      (set-file-modes file #o000)
      (remhash file agent-sidebar--parse-cache)
      (should-error (agent-sidebar--ensure-parsed (gethash file agent-sidebar--entries)))
      (set-file-modes file #o600)
      (agent-sidebar-refresh) (merge--drain)
      (should-not (plist-get (agent-sidebar--cached-meta (gethash file agent-sidebar--entries)) :error)))))

