(ert-deftest merge-shell-activation-uses-recovery-or-session-picker ()
  (merge--fixture
    (let* ((file (merge--markdown root "missing"))
           (config '((:mode-line-name . "Claude"))) calls)
      (agent-sidebar-refresh) (merge--drain)
      (cl-letf (((symbol-function 'agent-shell-sidebar--start)
                 (lambda (directory cfg &optional session strategy)
                   (push (list directory cfg session strategy) calls) buffer))
                ((symbol-function 'agent-shell-sidebar--pop-to) #'ignore)
                ((symbol-function 'agent-shell-sidebar--select-config) (lambda (_) config)))
        (agent-sidebar--agent-shell-visit (gethash file agent-sidebar--entries))
        (should (equal (car calls) (list root config nil 'prompt)))
        (merge--json-file root store "recovered")
        (agent-sidebar--agent-shell-visit (gethash file agent-sidebar--entries))
        (should (equal (car calls) (list root config "recovered" nil)))))))

(ert-deftest merge-terminal-arguments-directory-and-reuse ()
  (merge--fixture
    (let* ((file (merge--json-file root store "id"))
           (agent-sidebar-claude-cli-command "/bin/cat")
           (terminal (generate-new-buffer " *mock CLI terminal*"))
           (agent-sidebar-terminal-function
            (lambda (name program args directory)
              (should (stringp name)) (should (equal program "/bin/cat"))
              (should (equal args '("--resume" "id"))) (should (equal directory root))
              (with-current-buffer terminal
                (make-process :name "merge-local-process" :buffer terminal :command '("/bin/cat") :noquery t))
              terminal)))
      (unwind-protect
          (progn
            (agent-sidebar-refresh) (merge--drain)
            (cl-letf (((symbol-function 'agent-shell-sidebar--pop-to) #'ignore))
              (agent-sidebar--claude-visit (gethash file agent-sidebar--entries))
              (let ((agent-sidebar-terminal-function (lambda (&rest _) (ert-fail "Duplicate terminal"))))
                (agent-sidebar--claude-visit (gethash file agent-sidebar--entries))))
            (should (agent-sidebar--owned-file-p file)))
        (when-let* ((process (get-buffer-process terminal))) (delete-process process))
        (kill-buffer terminal)))))

