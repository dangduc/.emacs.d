(ert-deftest merge-terminal-ownership-prevents-delete-until-process-exits ()
  (merge--fixture
    (let* ((file (merge--json-file root store "owned"))
           (alias (expand-file-name "alias.jsonl" temporary))
           (terminal (generate-new-buffer " *merge owner*"))
           (delete-by-moving-to-trash nil))
      (make-symbolic-link file alias)
      (unwind-protect
          (progn
            (with-current-buffer terminal
              (make-process :name "merge-owner" :buffer terminal :command '("/bin/cat") :noquery t)
              (setq-local agent-sidebar--terminal-file alias))
            (agent-sidebar-refresh) (merge--drain)
            (merge--goto file) (agent-sidebar-mark-delete)
            (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
              (agent-sidebar-execute)
              (should (file-exists-p file))
              (should (eq (gethash file agent-sidebar--marks) 'delete))
              (delete-process (get-buffer-process terminal))
              (agent-sidebar-execute)
              (should-not (file-exists-p file))
              (should-not (gethash file agent-sidebar--marks))))
        (when-let* ((process (get-buffer-process terminal))) (delete-process process))
        (kill-buffer terminal)))))

(ert-deftest merge-buffer-isolation-and-legacy-buffer-upgrade ()
  (merge--fixture
    (merge--markdown root "one" "id")
    (agent-sidebar-refresh)
    (let ((old (get-buffer-create agent-sidebar-name))
          (cache agent-sidebar--parse-cache) (timer agent-sidebar--parse-timer))
      (with-current-buffer old
        (agent-shell-sidebar-mode)
        (puthash "preserved mark" 'delete agent-shell-sidebar--marks)
        (setq agent-shell-sidebar--filter "preserved filter"))
      (should (eq old (agent-sidebar--get-or-create-buffer)))
      (with-current-buffer old
        (should (derived-mode-p 'agent-sidebar-mode))
        (should (eq (gethash "preserved mark" agent-sidebar--marks) 'delete))
        (should (equal "preserved filter" agent-sidebar--filter))
        (should-not (eq cache agent-sidebar--parse-cache))
        (should (eq (key-binding (kbd "RET")) 'agent-sidebar-visit))
        (should (eq (key-binding (kbd "G")) 'agent-sidebar-set-grouping)))
      (kill-buffer old)
      (should (eq timer agent-sidebar--parse-timer))
      (merge--drain)
      (should (string-search "Prompt one" (buffer-string))))))

(defconst merge--argv-fixture
  (expand-file-name "argv-fixture.py" (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest merge-real-term-process-receives-exact-argv-and-cwd ()
  (merge--fixture
    (let* ((output (expand-file-name "arguments.json" temporary))
           (program (executable-find "python3"))
           (args '("two words" "x'y" "$(never-execute)")) target)
      (should program)
      (cl-letf (((symbol-function 'ghostel-exec) nil) ((symbol-function 'vterm) nil)
                ((symbol-function 'agent-shell-sidebar--pop-to) #'ignore))
        (unwind-protect
            (progn
              (setq target (agent-sidebar--launch-terminal
                            "merge argv" program (append (list merge--argv-fixture output) args) root))
              (let ((process (get-buffer-process target)) (deadline (+ (float-time) 5)))
                (while (and (process-live-p process) (< (float-time) deadline))
                  (accept-process-output process 0.05))
                (should (= (process-exit-status process) 0)))
              (with-temp-buffer
                (insert-file-contents output)
                (let ((data (json-parse-buffer :object-type 'alist :array-type 'list)))
                  (should (equal (alist-get 'argv data) args))
                  (should (equal (file-truename (alist-get 'cwd data))
                                 (directory-file-name (file-truename root)))))))
          (when (buffer-live-p target)
            (when-let* ((process (get-buffer-process target))) (delete-process process))
            (kill-buffer target)))))))
