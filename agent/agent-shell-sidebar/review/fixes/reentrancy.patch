+                  (agent-shell-sidebar--update-header-line)))
+            (when (buffer-live-p owner)
+              (with-current-buffer owner
+                (when (derived-mode-p 'agent-shell-sidebar-mode)
+                  (agent-shell-sidebar--start-parse-timer))))))))))
 
