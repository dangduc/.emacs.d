+/* =====================================================================
+ * Result cache — phase 1: exact-match lookup, LRU eviction, MRU touch
+ * ===================================================================== */
+
+static ScoredStr make_top(const char *str, int score) {
+  ScoredStr s = {0};
+  s.str   = (char *)str;   /* not freed by the cache (cache strdups internally) */
+  s.score = score;
+  return s;
+}
