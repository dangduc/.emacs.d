+  CHECK(out_count == 2);
+  CHECK(out_gen == 1000);
+  CHECK(out != NULL);
+  CHECK(out[0].score == 42);
+  CHECK(strcmp(out[0].str, "alpha") == 0);
+  CHECK(out[1].score == 17);
