+     than creating a duplicate.  Verify count stays at 1 and the new
+     data wins. */
+  Cache c;
+  cache_init(&c, 20);
+  ScoredStr v1[1] = { make_top("alpha", 10) };
+  ScoredStr v2[2] = { make_top("alpha", 99), make_top("beta", 50) };
